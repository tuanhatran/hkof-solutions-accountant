{
  "$schema": "https://opencode.ai/config.json",

  // New sessions start on the writable lead; it edits `.handoff/` only and asks builder to write code.
  "default_agent": "lead",

  // Root AGENTS.md is loaded automatically. These files add the detailed rules.
  "instructions": [".opencode/instructions/*.md"],

  // Superpowers skills vendored for Qoder remain the single source of truth.
  "skills": [".qoder/skills"],

  // Absolute project rules: never commit, push, reset, clean, stash or create worktrees.
  "permissions": [
    { "action": "shell", "resource": "*git commit*", "effect": "deny" },
    { "action": "shell", "resource": "*git push*", "effect": "deny" },
    { "action": "shell", "resource": "*git reset*", "effect": "deny" },
    { "action": "shell", "resource": "*git clean*", "effect": "deny" },
    { "action": "shell", "resource": "*git stash*", "effect": "deny" },
    { "action": "shell", "resource": "*git worktree*", "effect": "deny" },
    { "action": "shell", "resource": "*git branch -d*", "effect": "deny" },
    { "action": "shell", "resource": "*git branch -D*", "effect": "deny" }
  ]
}
