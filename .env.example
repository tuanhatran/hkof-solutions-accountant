# Copy to .env (git-ignored): cp .env.example .env

# Host ports
FRONTEND_PORT=8080
# Mailpit web UI and REST API (SMTP stays on 1025 inside the compose network)
MAILPIT_UI_PORT=8025
# Dev overlay only
BACKEND_PORT=8081
DB_PORT=5432

# PostgreSQL
DB_NAME=homeofficeexpenses
DB_USER=homeofficeexpenses
DB_PASSWORD=change-me-please

# Ollama, reached from the backend container.
# Compose profile "ollama" instead: OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b

# Optional: public URL put in the confirmation e-mail link.
# Defaults to the "make up" frontend port (http://localhost:8080/confirm-email
# with FRONTEND_PORT=8080) and to http://localhost:5173/confirm-email with "make dev".
# APP_AUTH_CONFIRMATION_URL=http://localhost:8080/confirm-email

# true: backend image includes LibreOffice (DOCX templates, phase 2)
WITH_LIBREOFFICE=false
